# =============================================================================
# Luckagent 配置文件
# 复制为 .env 后按需修改；改动需要重启（luckagent restart --all）才生效。
# =============================================================================

# 多 bot 模式（推荐）：指向 bots.json（可用管理台维护）。
# 设置后，下面的 FEISHU_APP_ID/SECRET 单 bot 模式被忽略。
BOTS_CONFIG=./bots.json

# 单 bot 模式（不建 bots.json 时的最简配置）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# CLAUDE_DEFAULT_WORKING_DIRECTORY=/path/to/your/project

# =============================================================================
# Claude Code 引擎（默认引擎）
# 认证二选一：① 直连 API：填 ANTHROPIC_API_KEY（可配 ANTHROPIC_BASE_URL）
#            ② 订阅登录：本机安装 Claude Code CLI 并登录，填 CLAUDE_EXECUTABLE_PATH
# =============================================================================

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=
# CLAUDE_MODEL=claude-fable-5
# CLAUDE_MAX_TURNS=50
# CLAUDE_MAX_BUDGET_USD=1.0
# CLAUDE_EXECUTABLE_PATH=~/.local/bin/claude
# CLAUDE_BACKEND=pty            # pty（默认）| sdk

# 是否禁用 Claude 自动记忆（0 = 开启自动记忆）
CLAUDE_CODE_DISABLE_AUTO_MEMORY=0

# =============================================================================
# =============================================================================


# =============================================================================
# DeepSeek 引擎（可选，bots.json 里 engine: "deepseek" 的 bot 使用）
# 走 DeepSeek 官方的 Anthropic 兼容端点，无需安装任何 CLI，只要 key。
# key 申请：https://platform.deepseek.com
# =============================================================================

# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash    # 可选：deepseek-v4-pro / deepseek-v4-flash-vision-exp（视觉）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# =============================================================================
# 桥接 HTTP API + Web 管理台（http://localhost:<API_PORT>/admin）
# =============================================================================

API_PORT=9100
# 管理台登录密钥 + API Bearer 密钥（install.sh 会自动生成随机值）
API_SECRET=

# 默认只监听 127.0.0.1；需要局域网访问时显式打开（务必配合防火墙）
# LUCKAGENT_API_HOST=0.0.0.0

# 周期任务的默认时区（IANA 格式）
# SCHEDULE_TIMEZONE=Asia/Shanghai

# 发送暂存目录：放进去的文件会被自动发到对应会话并在发送后删除。
# 默认 <系统临时目录>/luckagent-outputs-<用户名>/<chatId>/
# OUTPUTS_BASE_DIR=

# =============================================================================
# luckagent-core 中央服务（共享记忆 / 技能中心 / Agent 总线）
# =============================================================================
# CLI 的 memory/skills/agents/inbox 子命令走这里。
# 首次启动后用 packages/server/bin/central-admin 签发个人 token，
# 写入 ~/.luckagent-core/token（或直接填在下面）。

# LUCKAGENT_CORE_URL=http://localhost:9200
# LUCKAGENT_CORE_TOKEN=

# =============================================================================
# 飞书服务应用（Wiki 同步 / 文档读取，可选）
# 不设置时回退用第一个 bot 的凭证。
# =============================================================================

# FEISHU_SERVICE_APP_ID=cli_xxx
# FEISHU_SERVICE_APP_SECRET=xxx

# Wiki 同步（共享记忆 → 飞书知识库，单向、手动触发）
# WIKI_SYNC_ENABLED=true
# WIKI_SPACE_NAME=Luckagent Memory
# WIKI_SPACE_ID=
# WIKI_SYNC_THROTTLE_MS=300
# WIKI_SYNC_STATE_DIR=./data

# =============================================================================
# 跨实例互联 Peers（可选：多台机器上的 Luckagent 互相发现与派活）
# =============================================================================

# LUCKAGENT_PEERS=http://remote-host:9100
# LUCKAGENT_PEER_SECRETS=remote-api-secret
# LUCKAGENT_PEER_NAMES=alice
# LUCKAGENT_PEER_POLL_INTERVAL_MS=30000
# LUCKAGENT_ALLOWED_PEER_CIDRS=10.0.0.0/8,192.168.0.0/16

# =============================================================================
# 语音 TTS（/api/tts 与飞书语音回复；不配置则用免费的 Edge TTS）
# =============================================================================

# 豆包/火山（推荐）
# VOLCENGINE_TTS_APPID=
# VOLCENGINE_TTS_ACCESS_KEY=
# VOLCENGINE_TTS_RESOURCE_ID=volc.service_type.10029

# OpenAI TTS（可选回退）＋ openai-image-gen 生图技能（也认 OPENAI_IMAGE_API_KEY 独立配置）
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_API_KEY=sk-...

# ElevenLabs（可选）
# ELEVENLABS_API_KEY=

# 火山方舟（image-gen 技能的 Seedream 生图；需在方舟控制台开通对应模型）
# ARK_API_KEY=
# SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628   # 模型滚版本时在此覆盖

# 飞书语音回复默认行为
# LUCKAGENT_VOICE_REPLY_DEFAULT_ON=true
# LUCKAGENT_VOICE_REPLY_PROVIDER=doubao
# LUCKAGENT_VOICE_REPLY_MAX_CHARS=400
# LUCKAGENT_VOICE_REPLY_SUMMARY_PROVIDER=openai
# LUCKAGENT_VOICE_REPLY_SUMMARY_MODEL=gpt-4o-mini

# =============================================================================
# 代理（可选——注意：给飞书 API 加代理可能导致循环重定向，
# 遇到问题把飞书域名加进 NO_PROXY，或在手工执行脚本时 env -u HTTPS_PROXY）
# =============================================================================

# HTTP_PROXY=http://proxy.example.com:7890
# HTTPS_PROXY=http://proxy.example.com:7890
# NO_PROXY=open.feishu.cn,openspeech.bytedance.com,localhost,127.0.0.1

# =============================================================================
# 日志
# =============================================================================

LOG_LEVEL=info
