{
  "name": "luckagent",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haoyan-yam/luckagent.git"
  },
  "homepage": "https://github.com/haoyan-yam/luckagent#readme",
  "bugs": {
    "url": "https://github.com/haoyan-yam/luckagent/issues"
  },
  "description": "Luckagent — Feishu bot platform bridging chats to AI agent engines (Claude Code / DeepSeek)",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/cli",
    "packages/cli-core",
    "packages/metamemory",
    "packages/skill-hub",
    "packages/server",
    "packages/admin-ui"
  ],
  "scripts": {
    "build": "npm run build -w @luckagent/admin-ui && rm -rf dist/admin && mkdir -p dist && cp -r packages/admin-ui/dist dist/admin && tsc -b --force",
    "build:bridge": "tsc -p tsconfig.bridge.json",
    "build:packages": "npm run build --workspaces --if-present",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:bridge": "vitest run",
    "test:packages": "npm run test --workspaces --if-present",
    "lint": "eslint src/ tests/ && npm run lint --workspaces --if-present",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "update-cli": "cp bin/luckagent ~/.local/bin/luckagent && chmod +x ~/.local/bin/luckagent && echo \"Updated: luckagent\" && rm -f ~/.local/bin/mb ~/.local/bin/mm ~/.local/bin/mh",
    "build:admin": "npm run build -w @luckagent/admin-ui && rm -rf dist/admin && mkdir -p dist && cp -r packages/admin-ui/dist dist/admin"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.154",
    "@anthropic-ai/sdk": "^0.100.0",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "@volcengine/openapi": "^1.36.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.4.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "node-edge-tts": "^1.2.10",
    "node-pty": "^1.1.0",
    "openai": "^6.29.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "undici": "^7.24.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "buffer": "^6.0.3"
  }
}
